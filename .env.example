# ApplyPilot Environment Configuration for Docker

# --- LLM API Keys (Optional fallbacks for novel ATS reasoning) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Apply Pipeline Configuration ---
APPLYPILOT_HEADLESS=true
APPLYPILOT_MIN_SCORE=7
APPLYPILOT_MAX_WORKERS=2
APPLYPILOT_POLL_INTERVAL=30

# --- Email HITL Configuration ---
# Your notification email where unfamiliar questions will be sent
APPLYPILOT_USER_EMAIL=me@example.com

# --- Logging & Debugging ---
PYTHONUNBUFFERED=1
APPLYPILOT_LOG_LEVEL=INFO
