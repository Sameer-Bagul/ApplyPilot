# ApplyPilot Environment Configuration

# --- Local Mini LLM (Tier 3 CPU Inference via Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_NUM_GPU=0
OLLAMA_NUM_THREADS=8

# --- Cloud LLM API Keys (Tier 4 Fallback for complex essay reasoning) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Apply Pipeline Configuration ---
APPLYPILOT_HEADLESS=false
APPLYPILOT_MIN_SCORE=7
APPLYPILOT_MAX_WORKERS=2
APPLYPILOT_POLL_INTERVAL=30

# --- Email HITL (Human-in-the-Loop) Configuration ---
# Notification email where unfamiliar questions and OTP requests are dispatched
APPLYPILOT_USER_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Cloud Database Synchronization (Turso LibSQL / SQLite) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Logging & Runtime ---
PYTHONUNBUFFERED=1
APPLYPILOT_LOG_LEVEL=INFO

# --- Next.js Dashboard & NextAuth Configuration ---
NEXTAUTH_SECRET=your_32_char_random_secret_here
NEXTAUTH_URL=http://localhost:3000
ALLOWED_EMAILS=your.email@example.com
ADMIN_PASSCODE=your_secure_passcode_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
